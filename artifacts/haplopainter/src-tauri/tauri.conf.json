{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/alpha/tauri-conf.schema.json",
  "productName": "HaploClinical",
  "version": "0.1.0",
  "identifier": "org.haploclinical.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HaploClinical",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://relay.haploclinical.app; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/your-org/haploclinical/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER_ED25519_PUBLIC_KEY_FOR_UPDATE_SIGNING"
    }
  }
}