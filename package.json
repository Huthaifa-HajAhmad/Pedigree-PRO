{
  "name": "workspace",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tauri-commands": "node ./scripts/check-tauri-commands.js",
    "test": "pnpm --filter @workspace/ppro run test",
    "test:native": "node --test scripts/native-database-build.test.mjs && cargo test --manifest-path artifacts/ppro/src-tauri/Cargo.toml -p ppro-database --locked"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.167.0"
  }
}
