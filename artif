import { useState, useRef, useCallback, useEffect, useMemo } from "react";
import type { CanvasData, DragState, PedigreeNode, PedigreeEdge, PedigreeAnnotation } from "@/features/pedigree-editor/canvas/types";
import { NODE_SIZE, NODE_GAP, GEN_GRID } from "@/features/pedigree-editor/canvas/types";
import { DEFAULT_CANVAS, parseCanvas, computeSnapRows, snapToNearestRow } from "@/features/pedigree-editor/utils/helpers";
import { validatePedigree } from "@/lib/validate-pedigree";
import { computeAutoLayout } from "@/lib/auto-layout";
import { computeAutoLabels } from "@/lib/pedigree-labels";
import { generateThumbnail } from "@/lib/generate-thumbnail";
import { getAccentHex } from "@/lib/theme";
import { type InheritanceMode } from "@/lib/risk-calculator";
import type { PedigreeNode as PNode, CanvasData as CData } from "@/features/pedigree-editor/canvas/types";

export interface UsePedigreeEditorParams {
  id: number;
  pedigreeData: unknown;
  versionsData: unknown;
  versionsLoading: boolean;
  updatePedigree: ReturnType<typeof import("@workspace/api-client-react").useUpdatePedigree>;
  saveVersion: ReturnType<typeof import("@workspace/api-client-react").useSaveVersion>;
  restoreVersion: ReturnType<typeof import("@workspace/api-client-react").useRestoreVersion>;
  queryClient: import("@tanstack/react-query").QueryClient;
  queryKeys: typeof import("@workspace/api-client-react").queryKeys;
  draftEnabledRef: React.MutableRefObject<boolean>;
  draftKeyRef: React.MutableRefObject<string>;
  canvasRef: React.RefObject<CanvasData | null>;
  tabs: Array<{ id: number; title: string }>;
  openTab: (id: number, title: string) => void;
  closeTab: (tabId: number) => void;
  navigate: (to: string) => void;
}

export function usePedigreeEditor(params: UsePedigreeEditorParams) {
  const { id, pedigreeData, versionsData, versionsLoading, updatePedigree, saveVersion, restoreVersion, queryClient, queryKeys, draftEnabledRef, draftKeyRef, canvasRef, tabs, openTab, closeTab, navigate } = params;

  // ── Core state ──────────────────────────────────────────────────────────────
  const [canvas, setCanvas] = useState<CanvasData>(DEFAULT_CANVAS);
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [history, setHistory] = useState<CanvasData[]>([]);
  const [future, setFuture] = useState<CanvasData[]>([]);
  const [dragging, setDragging] = useState<DragState | null>(null);
  const [isDragging, setIsDragging] = useState(false);
  const [viewBox, setViewBox] = useState({ x: 0, y: 0, zoom: 1 });
  const [panning, setPanning] = useState<{ startX: number; startY: number; vbX: number; vbY: number } | null>(null);

  // ── UI toggle state ────────────────────────────────────────────────────────
  const [showVersions, setShowVersions] = useState(false);
  const [showSaveModal, setShowSaveModal] = useState(false);
  const [sessionLabel, setSessionLabel] = useState("");
  const [showShareModal, setShowShareModal] = useState(false);
  const [showExportMenu, setShowExportMenu] = useState(false);
  const [exportingFormat, setExportingFormat] = useState<string | null>(null);
  const [linkMode, setLinkMode] = useState<"couple" | "parent-child" | "consanguinity" | null>(null);
  const [linkSource, setLinkSource] = useState<string | null>(null);
  const [saveStatus, setSaveStatus] = useState<"idle" | "saving" | "saved">("idle");
  const [snapEnabled, setSnapEnabled] = useState(true);
  const [snapRows, setSnapRows] = useState<number[]>([]);
  const [showValidation, setShowValidation] = useState(false);
  const [expandedIssueId, setExpandedIssueId] = useState<string | null>(null);
  const [showLayoutMenu, setShowLayoutMenu] = useState(false);
  const [liveLayout, setLiveLayout] = useState(false);
  const [showLegend, setShowLegend] = useState(false);
  const [selectedAnnotationId, setSelectedAnnotationId] = useState<string | null>(null);
  const [annDragging, setAnnDragging] = useState<{ annId: string; startSVG: { x: number; y: number }; initOffset: { x: number; y: number } } | null>(null);
  const [showTemplates, setShowTemplates] = useState(false);
  const [riskMode, setRiskMode] = useState<InheritanceMode>("AR");
  const [showRiskCalc, setShowRiskCalc] = useState(false);
  const [showRiskPanel, setShowRiskPanel] = useState(false);
  const [showAutoLabels, setShowAutoLabels] = useState(true);
  const [showLabelsMenu, setShowLabelsMenu] = useState(false);
  const [showMinimap, setShowMinimap] = useState(true);
  const [showGrid, setShowGrid] = useState(true);
  const [contextMenu, setContextMenu] = useState<{ nodeId: string; x: number; y: number } | null>(null);
  const [editModalNodeId, setEditModalNodeId] = useState<string | null>(null);
  const [showSearch, setShowSearch] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [searchMatchIndex, setSearchMatchIndex] = useState(0);
  const [showTabPicker, setShowTabPicker] = useState(false);
  const searchInputRef = useRef<HTMLInputElement>(null);

  // ── Sync from API ──────────────────────────────────────────────────────────
  useEffect(() => {
    if (pedigreeData && (pedigreeData as any).canvas_data !== undefined) {
      setCanvas(parseCanvas((pedigreeData as any).canvas_data));
    }
  }, [(pedigreeData as any)?.canvas_data]);

  useEffect(() => {
    if (pedigreeData && (pedigreeData as any).title && id) openTab(id, (pedigreeData as any).title);
  }, [(pedigreeData as any)?.title, id, openTab]);

  useEffect(() => { canvasRef.current = canvas; }, [canvas]);

  // ── Auto-save ─────────────────────────────────────────────────────────────
  const autoSave = useCallback((newCanvas: CanvasData) => {
    setSaveStatus("saving");
    updatePedigree.mutate(
      { id, input: { canvas_data: JSON.stringify(newCanvas) } },
      {
        onSuccess: () => {
          queryClient.invalidateQueries({ queryKey: queryKeys.pedigree(id) });
          setSaveStatus("saved");
          setTimeout(() => setSaveStatus("idle"), 2000);
          try { localStorage.removeItem(`haplopainter_draft_${id}`); } catch {}
        },
        onError: () => setSaveStatus("idle"),
      }
    );
  }, [id, updatePedigree, queryClient]);

  const updateCanvas = useCallback((updater: (prev: CanvasData) => CanvasData, opts?: { skipHistory?: boolean }) => {
    setCanvas((prev) => {
      const next = updater(prev);
      if (!opts?.skipHistory) { setHistory((h) => [...h.slice(-49), prev]); setFuture([]); }
      autoSave(next);
      if (draftEnabledRef.current) {
        try { localStorage.setItem(draftKeyRef.current, JSON.stringify({ canvas: next, at: Date.now() })); } catch {}
      }
      return next;
    });
  }, [autoSave]);

  // ── Derived values ────────────────────────────────────────────────────────
  const autoLabels = useMemo(() => computeAutoLabels(canvas.nodes, canvas.edges), [canvas.nodes, canvas.edges]);
  const validation = useMemo(() => validatePedigree(canvas), [canvas]);
  const singleSelected = selectedIds.size === 1 ? canvas.nodes.find((n) => selectedIds.has(n.id)) ?? null : null;
  const anySelected = selectedIds.size > 0;

  const searchMatches = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return [] as string[];
    return canvas.nodes.filter((n) => (n.label || "").toLowerCase().includes(q) || (n.age || "").toLowerCase().includes(q) || n.type.toLowerCase().includes(q)).map((n) => n.id);
  }, [canvas.nodes, searchQuery]);

  useEffect(() => {
    if (searchMatches.length === 0) return;
    setSelectedIds(new Set([searchMatches[Math.min(searchMatchIndex, searchMatches.length - 1)]]));
  }, [searchMatches, searchMatchIndex]);

  const generationRailEntries = useMemo(() => {
    if (!showAutoLabels || canvas.nodes.length === 0) return [];
    const genGroups = new Map<string, number[]>();
    for (const node of canvas.nodes) { const label = autoLabels.get(node.id); if (!label) continue; const roman = label.split(":")[0]; if (!genGroups.has(roman)) genGroups.set(roman, []); genGroups.get(roman)!.push(node.y); }
    return [...genGroups.entries()].map(([roman, ys]) => { const sorted = [...ys].sort((a, b) => a - b); return { roman, y: sorted[Math.floor(sorted.length / 2)] }; }).sort((a, b) => a.y - b.y);
  }, [canvas.nodes, autoLabels, showAutoLabels]);

  const legendEntries = useMemo(() => {
    const entries: Array<{ key: string; label: string }> = [];
    const nt = new Set(canvas.nodes.map((n) => n.type));
    const et = new Set(canvas.edges.map((e) => e.type));
    if (nt.has("male")) entries.push({ key: "male", label: "Male" });
    if (nt.has("female")) entries.push({ key: "female", label: "Female" });
    if (nt.has("unknown")) entries.push({ key: "unknown", label: "Unknown sex" });
    if (nt.has("pregnancy")) entries.push({ key: "pregnancy", label: "Pregnancy" });
    if (nt.has("sab")) entries.push({ key: "sab", label: "SAB / Stillbirth" });
    if (canvas.nodes.some((n) => n.affected)) entries.push({ key: "affected", label: "Affected" });
    if (canvas.nodes.some((n) => n.carrier && !n.affected)) entries.push({ key: "carrier", label: "Carrier" });
    if (canvas.nodes.some((n) => n.deceased)) entries.push({ key: "deceased", label: "Deceased" });
    if (canvas.nodes.some((n) => n.proband)) entries.push({ key: "proband", label: "Proband (index)" });
    if (et.has("couple")) entries.push({ key: "couple", label: "Partners" });
    if (et.has("consanguinity")) entries.push({ key: "consanguinity", label: "Consanguineous union" });
    if (et.has("parent-child")) entries.push({ key: "parent-child", label: "Parent–Child" });
    return entries;
  }, [canvas]);

  // ── Undo / Redo ───────────────────────────────────────────────────────────
  const undo = useCallback(() => {
    setHistory((h) => { if (h.length === 0) return h; const target = h[h.length - 1]; const rest = h.slice(0, -1); setCanvas((current) => { setFuture((f) => [...f.slice(-49), current]); autoSave(target); return target; }); return rest; });
  }, [autoSave]);
  const redo = useCallback(() => {
    setFuture((f) => { if (f.length === 0) return f; const target = f[f.length - 1]; const rest = f.slice(0, -1); setCanvas((current) => { setHistory((h) => [...h.slice(-49), current]); autoSave(target); return target; }); return rest; });
  }, [autoSave]);

  // ── Node operations ───────────────────────────────────────────────────────
  const addNode = useCallback((type: PedigreeNode["type"]) => {
    const existingNodes = canvasRef.current!.nodes;
    const vbW = 1400 * viewBox.zoom, vbH = 900 * viewBox.zoom;
    const findSpawnPos = (): { x: number; y: number } => {
      if (existingNodes.length === 0) return { x: viewBox.x + vbW / 2, y: viewBox.y + vbH / 2 };
      const visible = existingNodes.filter((n) => n.y >= viewBox.y - NODE_SIZE && n.y <= viewBox.y + vbH + NODE_SIZE);
      const anchor = visible.length > 0 ? visible : existingNodes;
      const maxY = Math.max(...anchor.map((n) => n.y));
      const genRow = Math.round(maxY / GEN_GRID) * GEN_GRID;
      const rowNodes = existingNodes.filter((n) => Math.abs(n.y - genRow) < NODE_GAP / 2);
      const startX = rowNodes.length > 0 ? Math.max(...rowNodes.map((n) => n.x)) + NODE_GAP : viewBox.x + NODE_GAP;
      for (let ro = 0; ro <= 3; ro++) { for (let co = 0; co < 12; co++) { const cx = startX + co * NODE_GAP, cy = genRow + ro * GEN_GRID; if (existingNodes.every((n) => Math.hypot(n.x - cx, n.y - cy) >= NODE_GAP)) return { x: cx, y: cy }; } }
      return { x: viewBox.x + vbW / 2, y: Math.max(...existingNodes.map((n) => n.y)) + GEN_GRID };
    };
    const { x, y } = findSpawnPos();
    updateCanvas((prev) => ({ ...prev, nodes: [...prev.nodes, { id: `n${Date.now()}`, type, affected: false, carrier: false, deceased: false, proband: false, label: "", age: "", x, y }] }));
    setSelectedIds(new Set([`n${Date.now()}`]));
  }, [updateCanvas, viewBox]);

  const addContextNode = useCallback((relationship: "child" | "sibling" | "partner") => {
    if (selectedIds.size !== 1) return;
    const [selId] = selectedIds;
    const now = Date.now();
    const newId = `n${now}`;
    updateCanvas((prev) => {
      const sel = prev.nodes.find((n) => n.id === selId);
      if (!sel) return prev;
      const STEP_X = 110, STEP_Y = 150;
      let newX: number, newY: number, newType: PedigreeNode["type"];
      const newEdges: PedigreeEdge[] = [];
      if (relationship === "child") {
        newY = sel.y + STEP_Y; newType = "unknown";
        const coupleEdge = prev.edges.find((ed) => ed.type === "couple" && (ed.sourceId === selId || ed.targetId === selId));
        if (coupleEdge) {
          const partnerId = coupleEdge.sourceId === selId ? coupleEdge.targetId : coupleEdge.sourceId;
          const partner = prev.nodes.find((n) => n.id === partnerId);
          newX = partner ? (sel.x + partner.x) / 2 : sel.x + STEP_X / 2;
          newEdges.push({ id: `e${now}`, type: "parent-child", sourceId: selId, targetId: newId }, { id: `e${now + 1}`, type: "parent-child", sourceId: partnerId, targetId: newId });
        } else {
          const mateId = `n${now + 100}`;
          const mateType = sel.type === "female" ? "male" : "female";
          newX = sel.x + STEP_X / 2;
          newEdges.push({ id: `e${now}`, type: "couple", sourceId: selId, targetId: mateId }, { id: `e${now + 1}`, type: "parent-child", sourceId: selId, targetId: newId }, { id: `e${now + 2}`, type: "parent-child", sourceId: mateId, targetId: newId });
          return { ...prev, nodes: [...prev.nodes, { id: mateId, type: mateType, affected: false, carrier: false, deceased: false, proband: false, label: "", age: "", x: sel.x + STEP_X, y: sel.y }, { id: newId, type: newType, affected: false, carrier: false, deceased: false, proband: false, label: "", age: "", x: newX, y: newY }], edges: [...prev.edges, ...newEdges] };
        }
      } else if (relationship === "partner") {
        newType = sel.type === "male" ? "female" : sel.type === "female" ? "male" : "unknown";
        newX = sel.x + STEP_X; newY = sel.y;
        newEdges.push({ id: `e${now}`, type: "couple", sourceId: selId, targetId: newId });
      } else {
        newType = (sel.type === "sab" || sel.type === "pregnancy") ? "unknown" : sel.type;
        newY = sel.y; newX = sel.x + STEP_X;
      }
      return { ...prev, nodes: [...prev.nodes, { id: newId, type: newType, affected: false, carrier: false, deceased: false, proband: false, label: "", age: "", x: newX, y: newY }], edges: [...prev.edges, ...newEdges] };
    });
    setSelectedIds(new Set([newId]));
  }, [selectedIds, updateCanvas]);

  const toggleNodeProp = useCallback((nodeId: string, prop: "affected" | "carrier" | "deceased" | "proband") => {
    updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.map((n) => n.id === nodeId ? { ...n, [prop]: !n[prop] } : n) }));
    setContextMenu(null);
  }, [updateCanvas]);

  const setNodeType = useCallback((nodeId: string, type: PedigreeNode["type"]) => {
    updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.map((n) => n.id === nodeId ? { ...n, type } : n) }));
    setContextMenu(null);
  }, [updateCanvas]);

  const handleNodeContextMenu = useCallback((nodeId: string, e: React.MouseEvent) => { e.preventDefault(); e.stopPropagation(); setSelectedIds(new Set([nodeId])); setContextMenu({ nodeId, x: e.clientX, y: e.clientY }); }, []);
  const handleNodeDoubleClick = useCallback((nodeId: string, e: React.MouseEvent) => { e.stopPropagation(); setSelectedIds(new Set([nodeId])); setEditModalNodeId(nodeId); }, []);

  const deleteSelected = useCallback(() => {
    if (selectedIds.size === 0) return;
    const ids = selectedIds;
    updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.filter((n) => !ids.has(n.id)), edges: prev.edges.filter((e) => !ids.has(e.sourceId) && !ids.has(e.targetId)), annotations: prev.annotations.filter((a) => !ids.has(a.nodeId)) }));
    setSelectedIds(new Set()); setSelectedAnnotationId(null);
  }, [selectedIds, updateCanvas]);

  const updateSelectedNode = useCallback((updates: Partial<PedigreeNode>) => {
    if (selectedIds.size !== 1) return;
    const [nodeId] = selectedIds;
    updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.map((n) => n.id === nodeId ? { ...n, ...updates } : n) }));
  }, [selectedIds, updateCanvas]);

  const bulkUpdate = useCallback((updates: Partial<PedigreeNode>) => {
    if (selectedIds.size === 0) return;
    const ids = selectedIds;
    updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.map((n) => ids.has(n.id) ? { ...n, ...updates } : n) }));
  }, [selectedIds, updateCanvas]);

  const alignSelected = useCallback((axis: "x" | "y") => {
    if (selectedIds.size < 2) return;
    const ids = selectedIds;
    updateCanvas((prev) => { const selected = prev.nodes.filter((n) => ids.has(n.id)); const avg = selected.reduce((s, n) => s + n[axis], 0) / selected.length; return { ...prev, nodes: prev.nodes.map((n) => ids.has(n.id) ? { ...n, [axis]: avg, pinned: true } : n) }; });
  }, [selectedIds, updateCanvas]);

  const addAnnotation = useCallback((nodeId: string) => {
    const ann: PedigreeAnnotation = { id: `a${Date.now()}`, nodeId, text: "Note", color: getAccentHex(), fontSize: 12, position: "above" };
    updateCanvas((prev) => ({ ...prev, annotations: [...prev.annotations, ann] }));
    setSelectedAnnotationId(ann.id);
  }, [updateCanvas]);

  const updateAnnotation = useCallback((annId: string, updates: Partial<PedigreeAnnotation>) => {
    updateCanvas((prev) => ({ ...prev, annotations: prev.annotations.map((a) => a.id === annId ? { ...a, ...updates } : a) }));
  }, [updateCanvas]);

  const deleteAnnotation = useCallback((annId: string) => {
    updateCanvas((prev) => ({ ...prev, annotations: prev.annotations.filter((a) => a.id !== annId) }));
    setSelectedAnnotationId(null);
  }, [updateCanvas]);

  const handleNodeClick = useCallback((nodeId: string, e: React.MouseEvent) => {
    if (linkMode && linkSource) {
      if (linkSource !== nodeId) {
        if (linkMode === "consanguinity") {
          updateCanvas((prev) => { const kept = prev.edges.filter((ed) => !(ed.type === "couple" && ((ed.sourceId === linkSource && ed.targetId === nodeId) || (ed.sourceId === nodeId && ed.targetId === linkSource)))); return { ...prev, edges: [...kept, { id: `e${Date.now()}`, type: "consanguinity", sourceId: linkSource, targetId: nodeId }] }; });
        } else if (linkMode === "parent-child") {
          updateCanvas((prev) => {
            const parentNode = prev.nodes.find((n) => n.id === linkSource);
            if (!parentNode) return prev;
            const hasPartner = prev.edges.some((ed) => (ed.type === "couple" || ed.type === "consanguinity") && (ed.sourceId === linkSource || ed.targetId === linkSource));
            if (hasPartner) return { ...prev, edges: [...prev.edges, { id: `e${Date.now()}`, type: "parent-child", sourceId: linkSource, targetId: nodeId }] };
            const mateType = parentNode.type === "male" ? "female" : parentNode.type === "female" ? "male" : "unknown";
            const ts = Date.now(), mateId = `n${ts}_auto`, mateX = parentNode.type === "female" ? parentNode.x - NODE_GAP : parentNode.x + NODE_GAP;
            return { ...prev, nodes: [...prev.nodes, { id: mateId, type: mateType, affected: false, carrier: false, deceased: false, proband: false, label: "", age: "", x: mateX, y: parentNode.y, pinned: true }], edges: [...prev.edges, { id: `e${Date.now()}`, type: "parent-child", sourceId: linkSource, targetId: nodeId }, { id: `ec${ts}`, type: "couple", sourceId: linkSource, targetId: mateId }, { id: `emc${ts}`, type: "parent-child", sourceId: mateId, targetId: nodeId }] };
          });
        } else {
          updateCanvas((prev) => ({ ...prev, edges: [...prev.edges, { id: `e${Date.now()}`, type: linkMode, sourceId: linkSource, targetId: nodeId }] }));
        }
      }
      setLinkMode(null); setLinkSource(null); return;
    }
    if (linkMode && !linkSource) { setLinkSource(nodeId); return; }
    if (e.metaKey || e.ctrlKey) { setSelectedIds((prev) => { const next = new Set(prev); if (next.has(nodeId)) next.delete(nodeId); else next.add(nodeId); return next; }); }
    else { setSelectedIds(new Set([nodeId])); }
  }, [linkMode, linkSource, updateCanvas]);

  const runAutoLayout = useCallback((respectPinned: boolean) => {
    updateCanvas((prev) => ({ ...prev, nodes: computeAutoLayout(prev.nodes, prev.edges, respectPinned) as PedigreeNode[] }));
  }, [updateCanvas]);

  const edgesRef = canvas.edges;
  const nodeCount = canvas.nodes.length;
  useEffect(() => { if (!liveLayout || nodeCount === 0) return; runAutoLayout(true); }, [liveLayout, edgesRef, nodeCount]);

  const navigateArrow = useCallback((dir: "ArrowUp" | "ArrowDown" | "ArrowLeft" | "ArrowRight") => {
    if (canvas.nodes.length === 0) return;
    if (!singleSelected) { setSelectedIds(new Set([ [...canvas.nodes].sort((a, b) => a.y - b.y || a.x - b.x)[0].id ])); return; }
    const { x, y } = singleSelected;
    const others = canvas.nodes.filter((n) => n.id !== singleSelected.id);
    let candidates: typeof others;
    if (dir === "ArrowRight") candidates = others.filter((n) => n.x > x + 5); else if (dir === "ArrowLeft") candidates = others.filter((n) => n.x < x - 5); else if (dir === "ArrowDown") candidates = others.filter((n) => n.y > y + 5); else candidates = others.filter((n) => n.y < y - 5);
    if (candidates.length === 0) return;
    setSelectedIds(new Set([candidates.reduce((best, n) => ((n.x - x) ** 2 + (n.y - y) ** 2 < (best.x - x) ** 2 + (best.y - y) ** 2 ? n : best)).id]));
  }, [canvas.nodes, singleSelected]);

  const bakeEmptyLabels = useCallback(() => { updateCanvas((prev) => ({ ...prev, nodes: prev.nodes.map((n) => { if (n.label) return n; const c = computeAutoLabels(prev.nodes, prev.edges).get(n.id); return c ? { ...n, label: c } : n; }) })); setShowLabelsMenu(false); }, [updateCanvas]);
  const bakeAllLabels = useCallback(() => { if (!window.confirm("Overwrite all node labels?")) return; updateCanvas((prev) => { const c = computeAutoLabels(prev.nodes, prev.edges); return { ...prev, nodes: prev.nodes.map((n) => ({ ...n, label: c.get(n.id) ?? n.label })) }; }); setShowLabelsMenu(false); }, [updateCanvas]);
  const handleCloseTab = useCallback((tabId: number) => { closeTab(tabId); if (tabId === id) { const remaining = tabs.filter((t) => t.id !== tabId); if (remaining.length > 0) { navigate(`/pedigrees/${remaining[Math.max(0, tabs.findIndex((t) => t.id === tabId))].id}`); } else { navigate("/pedigrees"); } } }, [closeTab, id, tabs, navigate]);

  // ── Version management ────────────────────────────────────────────────────
  const handleSaveVersion = () => { const a = `Session · ${canvas.nodes.length} node${canvas.nodes.length !== 1 ? "s" : ""} · ${new Date().toLocaleDateString()}`; setSessionLabel(a); setShowSaveModal(true); };
  const commitSaveVersion = () => { const thumb = generateThumbnail(canvas); saveVersion.mutate({ pedigreeId: id, input: { canvas_data: JSON.stringify(canvas), label: sessionLabel || null, thumbnail: thumb, saver_key: "" } }, { onSuccess: () => { queryClient.invalidateQueries({ queryKey: queryKeys.versions(id) }); setShowSaveModal(false); setSessionLabel(""); } }); };
  const handleDeleteVersion = (versionId: number) => { if (!confirm("Delete this saved session?")) return; alert("Version deletion is not yet available in this build. Coming in v0.2."); };
  const handleRestoreVersion = (versionId: number) => { if (!confirm("Restore this version?")) return; restoreVersion.mutate({ pedigreeId: id, versionId }, { onSuccess: (data: any) => { setCanvas(parseCanvas(data.canvas_data)); queryClient.invalidateQueries({ queryKey: queryKeys.pedigree(id) }); setShowVersions(false); } }); };

  return {
    canvas, setCanvas,
    selectedIds, setSelectedIds,
    history, setHistory, future, setFuture,
    dragging, setDragging, isDragging, setIsDragging,
    viewBox, setViewBox, panning, setPanning,
    showVersions, setShowVersions,
    showSaveModal, setShowSaveModal, sessionLabel, setSessionLabel,
    showShareModal, setShowShareModal,
    showExportMenu, setShowExportMenu, exportingFormat, setExportingFormat,
